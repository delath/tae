# ── Required ────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
TARGET_CHANNEL_ID=1234567890123456789

# ── llama.cpp server ─────────────────────────────────────────────────────────
# Filename of the .gguf inside ./models/ — no path, just the filename.
LLAMA_MODEL=Crow-4B-Opus-4.6-Distill-Heretic_Qwen3.5.Q5_K_M.gguf
LLAMA_CTX_SIZE=8192
LLAMA_THREADS=5

# ── LLM endpoint ─────────────────────────────────────────────────────────────
# Default points to the llama-server container over the internal Docker bridge.
# To use OpenAI or another hosted API, change the URL and set LLM_API_KEY.
LLAMACPP_URL=http://tae-llama-server:8080/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=local-model
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.85

# ── Trigger settings ─────────────────────────────────────────────────────────
VOLUME_TRIGGER_N=40
LENGTH_TRIGGER_CHARS=300
SILENCE_TRIGGER_MINUTES=60
HISTORY_LIMIT=40

# ── Persona ───────────────────────────────────────────────────────────────────
# Single line only. The entire character is defined here.
SYSTEM_PROMPT=You are a sarcastic, blunt, and informal bystander lurking in a Discord chat. You pop in occasionally with short, dry remarks or observations about whatever is being discussed. Keep replies brief — ideally one or two sentences. Never break character. Never introduce yourself. Never explain your behaviour.
